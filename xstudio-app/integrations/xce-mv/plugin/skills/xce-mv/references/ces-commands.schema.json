{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XCE_MV internal seven-image execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shot_count",
    "aspect_ratio",
    "full_bleed",
    "generate_images",
    "generate_media",
    "style",
    "shared_seed",
    "locked_anchors",
    "negative_prompt",
    "shots",
    "advance_scene",
    "last_frame",
    "start_command",
    "list_reviewed",
    "final_frame_confirmed",
    "shot_confirmations",
    "list_revision",
    "approved_revision"
  ],
  "properties": {
    "shot_count": {
      "const": 7
    },
    "aspect_ratio": {
      "const": "16:9"
    },
    "full_bleed": {
      "const": true
    },
    "generate_images": {
      "const": true
    },
    "generate_media": {
      "const": true
    },
    "style": {
      "enum": [
        "photorealistic",
        "comic_book"
      ]
    },
    "shared_seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "locked_anchors": {
      "type": "string",
      "minLength": 1
    },
    "negative_prompt": {
      "type": "string",
      "minLength": 1
    },
    "shots": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shot_number",
            "shot_type",
            "initial_state",
            "terminating_state",
            "prompt"
          ],
          "properties": {
            "shot_number": {
              "const": 1
            },
            "shot_type": {
              "type": "string",
              "minLength": 1,
              "description": "User-approved shot role; default recommendations may be modified."
            },
            "initial_state": {
              "type": "string",
              "minLength": 1
            },
            "terminating_state": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "pattern": "--ar 16:9$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shot_number",
            "shot_type",
            "initial_state",
            "terminating_state",
            "prompt"
          ],
          "properties": {
