              "const": 6
            },
            "shot_type": {
              "type": "string",
              "minLength": 1,
              "description": "User-approved shot role; default recommendations may be modified."
            },
            "initial_state": {
              "type": "string",
              "minLength": 1
            },
            "terminating_state": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "pattern": "--ar 16:9$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shot_number",
            "shot_type",
            "initial_state",
            "terminating_state",
            "prompt"
          ],
          "properties": {
            "shot_number": {
              "const": 7
            },
            "shot_type": {
              "type": "string",
              "minLength": 1,
              "description": "User-approved shot role; default recommendations may be modified."
            },
            "initial_state": {
              "type": "string",
              "minLength": 1
            },
            "terminating_state": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "pattern": "--ar 16:9$"
            }
          }
        }
      ],
      "items": false
    },
    "advance_scene": {
      "type": "boolean"
    },
    "last_frame": {
      "type": "string",
      "minLength": 1,
      "description": "Confirmed FF (Final Frame); LF is a compatibility alias."
    },
    "start_command": {
      "enum": [
        "Y",
        "GEN"
      ]
    },
    "list_reviewed": {
      "const": true
    },
    "final_frame_confirmed": {
      "const": true
    },
    "shot_confirmations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "const": true
      }
    },
    "list_revision": {
      "type": "integer",
      "minimum": 1
    },
    "approved_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "description": "Internal render plan only after approval. Runtime must ensure approved_revision equals list_revision, all confirmations are genuine, and Y/GEN is a fresh generation-gate response. JSON validation alone is not authorization."
}
