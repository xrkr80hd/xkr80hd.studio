              "const": 2
            },
            "shot_type": {
              "type": "string",
              "minLength": 1,
              "description": "User-approved shot role; default recommendations may be modified."
            },
            "initial_state": {
              "type": "string",
              "minLength": 1
            },
            "terminating_state": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "pattern": "--ar 16:9$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shot_number",
            "shot_type",
            "initial_state",
            "terminating_state",
            "prompt"
          ],
          "properties": {
            "shot_number": {
              "const": 3
            },
            "shot_type": {
              "type": "string",
              "minLength": 1,
              "description": "User-approved shot role; default recommendations may be modified."
            },
            "initial_state": {
              "type": "string",
              "minLength": 1
            },
            "terminating_state": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "pattern": "--ar 16:9$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shot_number",
            "shot_type",
            "initial_state",
            "terminating_state",
            "prompt"
          ],
          "properties": {
