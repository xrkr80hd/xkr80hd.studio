          "additionalProperties": false
        },
        "grade_id": {
          "type": "string",
          "maxLength": 2000
        },
        "grade_version": {
          "type": "integer",
          "minimum": 0
        },
        "aspect_ratio": {
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:3",
            "2.39:1"
          ]
        },
        "style": {
          "type": "string",
          "enum": [
            "Approved project style",
            "RL",
            "CB",
            "photorealistic",
            "comic_book"
          ]
        },
        "negative_constraints": {
          "type": "string",
          "maxLength": 2000
        },
        "scene_action": {
          "type": "string",
          "maxLength": 2000
        },
        "world_inspiration": {
          "type": "string",
          "maxLength": 2000
