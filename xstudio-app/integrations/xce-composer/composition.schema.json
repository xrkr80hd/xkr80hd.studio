{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XCE_COMPOSER 1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "module": {
      "type": "string",
      "enum": [
        "XCE_COMPOSER"
      ]
    },
    "source_url": {
      "type": "string",
      "enum": [
        "https://xstudio.xrkr80hd.studio"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "placements": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "plane": {
                "type": "string",
                "enum": [
                  "foreground",
                  "midground",
                  "background"
                ]
              },
              "action": {
                "type": "string",
                "enum": [
                  "as described",
                  "standing",
                  "walking",
                  "running",
                  "flying",
                  "arriving",
                  "interacting",
                  "observing",
                  "sitting",
                  "turning",
                  "jumping",
                  "landing",
                  "climbing",
                  "swimming",
                  "driving",
                  "riding",
                  "reaching",
                  "holding",
                  "crouching",
                  "looking back",
                  "departing"
                ]
              }
            },
            "required": [
              "asset_id",
              "x",
              "y",
              "plane",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "subject_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "inside",
                  "outside",
                  "on",
                  "underneath",
                  "beside",
                  "behind",
                  "in front of",
                  "above",
                  "below",
                  "approaching",
                  "departing",
                  "flying over",
                  "traveling through"
                ]
              },
              "object_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_-]+$"
              }
            },
            "required": [
              "subject_id",
              "relation",
              "object_id"
            ],
            "additionalProperties": false
          }
        },
        "camera": {
          "type": "object",
          "properties": {
            "shot": {
              "type": "string",
              "enum": [
                "establishing",
                "wide",
                "medium",
                "close-up",
                "aerial",
                "tracking",
                "over-the-shoulder",
                "POV"
              ]
            },
            "lens": {
              "type": "string",
              "maxLength": 2000
            },
            "angle": {
              "type": "string",
              "maxLength": 2000
            },
            "elevation": {
              "type": "string",
              "maxLength": 2000
            },
            "distance": {
              "type": "string",
              "maxLength": 2000
            },
            "framing": {
              "type": "string",
              "maxLength": 2000
            },
            "composition": {
              "type": "string",
              "maxLength": 2000
            },
            "movement": {
              "type": "string",
              "maxLength": 2000
            }
