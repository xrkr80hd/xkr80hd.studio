            "type": {
              "type": "string",
              "enum": [
                "natural",
                "studio",
                "cinematic",
                "directional",
                "ambient",
                "volumetric"
              ]
            },
            "direction": {
              "type": "string",
              "maxLength": 2000
            },
            "quality": {
              "type": "string",
              "maxLength": 2000
            }
