          "type": "object",
          "properties": {
            "terrain_features": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "architecture_features": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "weather_layers": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "elements": {
              "type": "array",
