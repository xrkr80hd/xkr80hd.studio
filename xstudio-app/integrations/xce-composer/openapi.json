{
  "openapi": "3.1.0",
  "info": {
    "title": "XCE_COMPOSER",
    "version": "1.0.0",
    "description": "Authenticated native XSTUDIO scene compilation and persistence. No image generation. Send exact project/asset IDs. Execution returns real images; do not rely on URL text."
  },
  "servers": [
    {
      "url": "https://xstudio.xrkr80hd.studio"
    }
  ],
  "security": [
    {
      "StudioConnector": []
    }
  ],
  "paths": {
    "/api/composer": {
      "get": {
        "operationId": "discoverComposer",
        "summary": "Discover projects, inventory/grades, saved compositions or research brief.",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "schema",
                "projects",
                "inventory",
                "read",
                "research",
                "resolve"
              ]
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asset_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asset_code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated result or verified image package"
          },
          "400": {
            "description": "Invalid scene or missing references"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "Stale project/composition version"
          },
          "423": {
            "description": "Folder locked"
          }
        }
      },
      "post": {
        "operationId": "operateComposer",
        "summary": "Compile or retrieve actual execution images; explicitly save/edit/duplicate a composition or stage/approve intelligence. Read-only tokens cannot save.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action",
                  "project_id"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "compile",
                      "execution",
                      "save",
                      "duplicate",
                      "intelligence",
                      "character_details",
                      "cast_group",
                      "character_state",
                      "scene_cast"
                    ]
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "configuration": {
                    "type": "object",
                    "properties": {
                      "placements": {
                        "type": "array",
                        "maxItems": 20,
                        "items": {
                          "type": "object",
                          "properties": {
                            "asset_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[a-zA-Z0-9_-]+$"
                            },
                            "x": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "y": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "plane": {
                              "type": "string",
                              "enum": [
                                "foreground",
                                "midground",
                                "background"
                              ]
                            },
                            "action": {
                              "type": "string",
                              "enum": [
                                "as described",
                                "standing",
                                "walking",
                                "running",
                                "flying",
                                "arriving",
                                "interacting",
                                "observing",
                                "sitting",
                                "turning",
                                "jumping",
                                "landing",
                                "climbing",
                                "swimming",
                                "driving",
                                "riding",
                                "reaching",
                                "holding",
                                "crouching",
                                "looking back",
                                "departing"
                              ]
                            },
                            "state_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[a-zA-Z0-9_-]+$"
                            },
                            "state_version": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "required": [
                            "asset_id",
                            "x",
                            "y",
                            "plane",
                            "action"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "relationships": {
                        "type": "array",
                        "maxItems": 50,
                        "items": {
                          "type": "object",
                          "properties": {
                            "subject_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[a-zA-Z0-9_-]+$"
                            },
                            "relation": {
                              "type": "string",
                              "enum": [
                                "inside",
                                "outside",
                                "on",
                                "underneath",
                                "beside",
                                "behind",
                                "in front of",
                                "above",
                                "below",
                                "approaching",
                                "departing",
                                "flying over",
                                "traveling through"
                              ]
                            },
                            "object_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[a-zA-Z0-9_-]+$"
                            }
                          },
                          "required": [
                            "subject_id",
                            "relation",
                            "object_id"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "camera": {
                        "type": "object",
