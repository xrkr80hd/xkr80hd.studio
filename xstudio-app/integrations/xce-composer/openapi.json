                            "type": "string",
                            "maxLength": 2000
                          },
                          "angle": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "elevation": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "distance": {
                            "type": "string",
                            "maxLength": 2000
