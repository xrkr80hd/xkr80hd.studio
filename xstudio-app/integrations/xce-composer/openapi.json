                            "seat": {
                              "type": "string",
                              "maxLength": 2000
                            },
                            "posture": {
                              "type": "string",
                              "maxLength": 2000
                            },
                            "equipment": {
                              "type": "string",
                              "maxLength": 2000
                            },
                            "movement": {
                              "type": "string",
                              "maxLength": 2000
                            }
                          },
                          "required": [
                            "id",
                            "character_id",
                            "mount_asset_id",
                            "mode",
                            "seat",
                            "posture",
                            "equipment",
                            "movement"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "character_directions": {
                        "type": "array",
                        "maxItems": 20,
