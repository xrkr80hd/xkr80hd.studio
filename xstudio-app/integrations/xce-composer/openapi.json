{
  "openapi": "3.1.0",
  "info": {
    "title": "XCE_COMPOSER",
    "version": "1.0.0",
    "description": "Authenticated native XSTUDIO scene compilation and persistence. No image generation. Send exact project/asset IDs. Execution returns real images; do not rely on URL text."
  },
  "servers": [
    {
      "url": "https://xstudio.xrkr80hd.studio"
    }
  ],
  "security": [
    {
      "StudioConnector": []
    }
  ],
  "paths": {
    "/api/composer": {
      "get": {
        "operationId": "discoverComposer",
        "summary": "Discover projects, inventory/grades, saved compositions or research brief.",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "projects",
                "inventory",
                "read",
                "research",
                "resolve"
              ]
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asset_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asset_code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated result or verified image package"
          },
          "400": {
            "description": "Invalid scene or missing references"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "Stale project/composition version"
          },
          "423": {
            "description": "Folder locked"
          }
        }
      },
      "post": {
        "operationId": "operateComposer",
        "summary": "Compile or retrieve actual execution images; explicitly save/edit/duplicate a composition or stage/approve intelligence. Read-only tokens cannot save.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action",
                  "project_id"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "compile",
                      "execution",
                      "save",
                      "duplicate",
                      "intelligence"
                    ]
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "configuration": {
                    "type": "object",
                    "properties": {
                      "placements": {
                        "type": "array",
                        "maxItems": 20,
                        "items": {
                          "type": "object",
                          "properties": {
                            "asset_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[a-zA-Z0-9_-]+$"
                            },
                            "x": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "y": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "plane": {
                              "type": "string",
                              "enum": [
                                "foreground",
                                "midground",
                                "background"
                              ]
                            },
                            "action": {
                              "type": "string",
                              "enum": [
                                "standing",
                                "walking",
                                "running",
                                "flying",
                                "arriving",
                                "interacting",
                                "observing"
                              ]
                            }
                          },
                          "required": [
                            "asset_id",
                            "x",
                            "y",
                            "plane",
                            "action"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "relationships": {
                        "type": "array",
                        "maxItems": 50,
                        "items": {
                          "type": "object",
                          "properties": {
                            "subject_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[a-zA-Z0-9_-]+$"
                            },
                            "relation": {
                              "type": "string",
                              "enum": [
                                "inside",
                                "outside",
                                "on",
                                "underneath",
                                "beside",
                                "behind",
                                "in front of",
                                "above",
                                "below",
                                "approaching",
                                "departing",
                                "flying over",
                                "traveling through"
                              ]
                            },
                            "object_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[a-zA-Z0-9_-]+$"
                            }
                          },
                          "required": [
                            "subject_id",
                            "relation",
                            "object_id"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "camera": {
                        "type": "object",
                        "properties": {
                          "shot": {
                            "type": "string",
                            "enum": [
                              "establishing",
                              "wide",
                              "medium",
                              "close-up",
                              "aerial",
                              "tracking",
                              "over-the-shoulder",
                              "POV"
                            ]
                          },
                          "lens": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "angle": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "elevation": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "distance": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "framing": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "composition": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "movement": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "shot",
                          "lens",
                          "angle",
                          "elevation",
                          "distance",
                          "framing",
                          "composition",
                          "movement"
                        ],
                        "additionalProperties": false
                      },
                      "environment": {
                        "type": "object",
                        "properties": {
                          "terrain": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "architecture": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "atmosphere": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "weather": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "time_of_day": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "terrain",
                          "architecture",
                          "atmosphere",
                          "weather",
                          "time_of_day"
                        ],
                        "additionalProperties": false
                      },
                      "lighting": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "natural",
                              "studio",
                              "cinematic",
                              "directional",
                              "ambient",
                              "volumetric"
                            ]
                          },
                          "direction": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "quality": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "type",
                          "direction",
                          "quality"
                        ],
                        "additionalProperties": false
                      },
                      "source_shot": {
                        "type": "object",
                        "properties": {
                          "list_id": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "shot_id": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "list_id",
                          "shot_id"
                        ],
                        "additionalProperties": false
                      },
                      "grade_id": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "grade_version": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "16:9",
                          "9:16",
                          "1:1",
                          "4:3",
                          "2.39:1"
                        ]
                      },
                      "style": {
                        "type": "string",
                        "enum": [
                          "Approved project style",
                          "RL",
                          "CB",
                          "photorealistic",
                          "comic_book"
                        ]
                      },
                      "negative_constraints": {
                        "type": "string",
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "placements",
                      "relationships",
                      "camera",
                      "environment",
                      "lighting",
                      "source_shot",
                      "grade_id",
                      "grade_version",
                      "aspect_ratio",
                      "style",
                      "negative_constraints"
                    ],
                    "additionalProperties": false
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "expected_revision": {
                    "type": "integer"
                  },
                  "expected_version": {
                    "type": "integer"
                  },
                  "confirm": {
                    "type": "boolean"
                  },
                  "asset_id": {
                    "type": "string"
                  },
                  "approve": {
                    "type": "boolean"
                  },
                  "profile": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated result or verified image package"
          },
          "400": {
            "description": "Invalid scene or missing references"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "Stale project/composition version"
          },
          "423": {
            "description": "Folder locked"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "StudioConnector": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing scoped, revocable XSTUDIO xst_ token. Never put the token in scene text or asset metadata."
      }
    }
  }
}
