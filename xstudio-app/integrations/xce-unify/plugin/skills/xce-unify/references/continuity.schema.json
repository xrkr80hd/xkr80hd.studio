  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "type": "string"
    },
    "handoff_protocol_id": {
      "const": "xce_live_handoff_v2",
      "type": "string"
    },
    "orchestrator": {
      "const": "@XCE_UNIFY",
