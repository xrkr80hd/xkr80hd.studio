# Supabase Fuschia Light House project public connection (safe for browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Verified sole owner Auth user UUID. Server only; no owner access without it.
XSTUDIO_OWNER_USER_ID=

# Server-only 32+ random bytes, base64url encoded. Required for password recovery grants.
XSTUDIO_RECOVERY_COOKIE_SECRET=

# Optional owner-only image generation. Leave empty to keep provider routes disabled.
GEMINI_API_KEY=
XAI_API_KEY=

# External tool ingest uses scoped tokens managed through Fuschia Edge Functions.
# No service key or external tool token is configured in Vercel.
