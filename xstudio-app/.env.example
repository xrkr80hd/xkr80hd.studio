# Supabase Fuschia Light House project public connection (safe for browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Verified sole owner Auth user UUID. Server only; no owner access without it.
XSTUDIO_OWNER_USER_ID=

# Server-only 32+ random bytes, base64url encoded. Required for password recovery grants.
XSTUDIO_RECOVERY_COOKIE_SECRET=

# Optional owner-only image generation. Leave empty to keep provider routes disabled.
GEMINI_API_KEY=
XAI_API_KEY=

# External tool ingest uses scoped tokens managed through Fuschia Edge Functions.
# The existing site uses no service-role key. MCP adds one server-only read credential.

# Read-only MCP gateway (server-only). Native OAuth grants come from owner consent.
# OPTIONAL: upstream credential for static API/external-JWT grants only.
# Native OAuth creates its own read-only encrypted delegation AFTER owner consent.
XSTUDIO_MCP_UPSTREAM_TOKEN=
# Optional static API/external-JWT grants; native OAuth does not use this list.
XSTUDIO_MCP_GRANTS=[]
# OPTIONAL external OAuth provider override. Leave blank for built-in XSTUDIO OAuth.
XSTUDIO_MCP_OAUTH_ISSUER=
XSTUDIO_MCP_OAUTH_JWKS=
# Shared Redis REST storage for native OAuth state AND atomic rate limits.
# Enable TLS and persistence; use a dedicated private credential, never a public key.
XSTUDIO_MCP_REDIS_URL=
XSTUDIO_MCP_REDIS_TOKEN=
# Exact browser origins, comma separated; native/server clients need no Origin.
XSTUDIO_MCP_ORIGINS=https://xstudio.xrkr80hd.studio

# Production default: dedicated server-only credential for Fuchsia OAuth state.
# Supersedes the optional Redis settings above; never expose this to browsers.
XSTUDIO_MCP_STATE_TOKEN=
